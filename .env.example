# ==============================================================================
# FIREBASE CONFIGURATION (EXAMPLE TEMPLATE)
# Copy this file to .env and fill in your actual private credentials.
# Never commit .env or service account keys to version control!
# ==============================================================================

# Option A: Path to downloaded Service Account JSON key (Recommended for local dev)
GOOGLE_APPLICATION_CREDENTIALS="./serviceAccountKey.json"

# Option B: Individual environment variables (Used for cloud hosting like Vercel/Render)
FIREBASE_PROJECT_ID="restaurantdatascraper"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk-fbsvc@restaurantdatascraper.iam.gserviceaccount.com"
FIREBASE_CLIENT_ID="101632877922882630773"

# Paste your private key enclosed in quotes, keeping the \n markers intact:
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"
